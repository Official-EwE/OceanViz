<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; align-items: center; align-self: center; justify-content: center;">
        <ui:VisualElement name="MainMenuWindow" style="flex-grow: initial; margin-top: 0; width: 255px; height: 279px; align-items: center; justify-content: center; align-self: center; flex-shrink: initial; flex-direction: column; background-color: rgb(48, 48, 48); padding-right: 0; padding-left: 0; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
            <ui:VisualElement style="height: 32px; flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: flex-end; align-self: stretch;">
                <ui:Button text="x" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CloseMenuButton" style="width: 24px; height: 24px; min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px; flex-grow: 0; flex-shrink: 0; align-self: center;" />
            </ui:VisualElement>
            <ui:VisualElement name="MainMenuNavigationPanel" style="flex-grow: 1; width: 255px; align-items: center; justify-content: center; align-self: center; flex-direction: column; padding-right: 24px; padding-left: 24px;">
                <ui:Button text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SettingsButton" style="align-self: stretch;" />
                <ui:Button text="Asset Browser" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AssetBrowserButton" style="align-self: stretch;" />
                <ui:Button text="Simulation Mode" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SimulationModeButton" style="align-self: stretch;" />
                <ui:Button text="Close OceanViz3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CloseAppButton" style="align-self: stretch;" />
            </ui:VisualElement>
            <ui:VisualElement name="SettingsPanel" style="display: none; flex-grow: 1; align-items: stretch; justify-content: flex-start; align-self: stretch; flex-direction: column; padding-top: 8px; padding-right: 24px; padding-bottom: 20px; padding-left: 24px;">
				<ui:Label text="Settings" name="SettingsTitleLabel" style="font-size: 18px; -unity-font-style: bold; margin-bottom: 18px; -unity-text-align: middle-center;" />
				<ui:Toggle label="Show Species Info on Cursor Hover" name="EntityHoverEnabledToggle" value="true" style="align-self: stretch;" />
				<ui:Toggle label="Show FPS Counter" name="FpsCounterEnabledToggle" value="false" style="align-self: stretch;" />
                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Button text="Back" name="CloseSettingsButton" style="align-self: stretch;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
